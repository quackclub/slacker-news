---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import SlackMention from "../components/SlackMention.astro";
import { renderBody } from "../lib/lexical";
import { getPostByPath, verifySession } from "../lib/payload";
import { formatStoryDate, getSiteConfig } from "../lib/content";

const site = await getSiteConfig();
const path = Astro.params.slug ?? "";
const post = await getPostByPath(path);

if (!post) {
  return Astro.redirect("/404");
}

if (post.gated) {
  const cookie = Astro.request.headers.get("cookie") ?? "";
  const authenticated = await verifySession(cookie);

  if (!authenticated) {
    const loginURL = new URL(`${import.meta.env.PUBLIC_PAYLOAD_URL}/admin/login`);
    loginURL.searchParams.set("redirect", Astro.url.href);
    return Astro.redirect(loginURL.toString());
  }
}

const bodyHTML = await renderBody(post.body);
const authorName = typeof post.author === "string" ? post.author : post.author?.name ?? post.author?.email;
const authorSlackId = typeof post.author === "string" ? undefined : post.author?.slackId;
---

<BaseLayout title={post.title} siteTitle={site.title} siteDescription={site.description}>
  <article class="story-page">
    <header class="story-header">
      <h1 class="story-title">{post.title}</h1>
      <div class="story-meta">
        {post.category && <span class="story-category">{post.category.toUpperCase()}</span>}
        {authorName && (
          <span class="story-author">
            By {authorSlackId ? <SlackMention name={authorName} id={authorSlackId} /> : authorName}
          </span>
        )}
        {authorName && " — "}
        <time>{formatStoryDate(new Date(post.date))}</time>
      </div>
      <hr class="story-rule" />
    </header>

    <div class="story-body" set:html={bodyHTML} />

    <footer class="story-footer">
      <a href="/">&larr; Back to front page</a>
    </footer>
  </article>
</BaseLayout>
