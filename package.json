{
  "name": "slacker-news-monorepo",
  "private": true,
  "packageManager": "bun@1.2.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:cms": "turbo dev --filter=cms",
    "build": "turbo build",
    "check": "turbo check",
    "postinstall": "node scripts/patch-payload-exports.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
