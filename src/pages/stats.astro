---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getStatsData } from "../lib/stats-logic.js";

export const prerender = false;

const { site, pages, news, essays, totalValue, chartLabels, chartValues } = await getStatsData();
---
<BaseLayout title="Pageview Stats" siteTitle={site.title} siteDescription={site.description}>
  <section class="stats-page">
    <h1>Pageview Stats</h1>

    <div class="stats-total-block">
      <span class="stats-total-label">All Views</span>
      <span class="stats-total-value">{totalValue.toLocaleString()}</span>
    </div>

    <div class="chart-block">
      <h2>Views Over Time</h2>
      <div class="chart-wrap">
        <canvas id="views-chart"
          data-labels={JSON.stringify(chartLabels)}
          data-values={JSON.stringify(chartValues)}>
        </canvas>
      </div>
    </div>

    <div class="stats-sections">
      <section class="stats-block">
        <h2>Pages</h2>
        <div class="stats-subtotal">
          <span class="stats-label">Total</span>
          <span class="stats-value">{pages.reduce((s, r) => s + (r.value ?? 0), 0).toLocaleString()}</span>
        </div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th scope="col">Views</th>
                <th scope="col">Path</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              {pages.map((row) => (
                <tr class="stats-row">
                  <td class="views-cell">{row.value?.toLocaleString() ?? "—"}</td>
                  <td><a href={row.path}>{row.path}</a></td>
                  <td>{row.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="stats-block">
        <h2>News</h2>
        <div class="stats-subtotal">
          <span class="stats-label">Total</span>
          <span class="stats-value">{news.reduce((s, r) => s + (r.value ?? 0), 0).toLocaleString()}</span>
        </div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th scope="col">Views</th>
                <th scope="col">Path</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              {news.map((row) => (
                <tr class="stats-row">
                  <td class="views-cell">{row.value?.toLocaleString() ?? "—"}</td>
                  <td><a href={row.path}>{row.path}</a></td>
                  <td>{row.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="stats-block">
        <h2>Essays</h2>
        <div class="stats-subtotal">
          <span class="stats-label">Total</span>
          <span class="stats-value">{essays.reduce((s, r) => s + (r.value ?? 0), 0).toLocaleString()}</span>
        </div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th scope="col">Views</th>
                <th scope="col">Path</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              {essays.map((row) => (
                <tr class="stats-row">
                  <td class="views-cell">{row.value?.toLocaleString() ?? "—"}</td>
                  <td><a href={row.path}>{row.path}</a></td>
                  <td>{row.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>

  <script>
    import Chart from "chart.js/auto";

    const ctx = document.getElementById("views-chart");
    if (ctx) {
      const labels = JSON.parse(ctx.dataset.labels || "[]");
      const values = JSON.parse(ctx.dataset.values || "[]");
      if (labels.length > 0) {
        new Chart(ctx, {
          type: "line",
          data: {
            labels,
            datasets: [{
              data: values,
              borderColor: "#000",
              backgroundColor: "transparent",
              borderWidth: 1.5,
              pointRadius: 0,
              pointHoverRadius: 3,
              pointHoverBackgroundColor: "#000",
              tension: 0.3,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: "#fff",
                titleColor: "#000",
                bodyColor: "#000",
                borderColor: "#000",
                borderWidth: 1,
                displayColors: false,
                callbacks: {
                  label: (ctx) => ctx.parsed.y.toLocaleString() + " views",
                }
              }
            },
            scales: {
              x: {
                grid: { color: "#ccc" },
                ticks: { color: "#666", font: { size: 11 } }
              },
              y: {
                grid: { color: "#ccc" },
                ticks: { color: "#666", font: { size: 11 }, callback: (v) => v.toLocaleString() }
              }
            }
          }
        });
      }
    }
  </script>
</BaseLayout>

<style>
  .stats-page {
    max-width: 56rem;
  }

  .stats-page h1 {
    margin-bottom: 1.5rem;
  }

  .stats-total-block {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-top: 2px solid #000;
    border-bottom: 1px solid #ddd;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .stats-total-label {
    color: #666;
  }

  .stats-total-value {
    font-size: 1.1rem;
  }

  .chart-block {
    margin-bottom: 2rem;
  }

  .chart-block h2 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: #444;
  }

  .chart-wrap {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 1rem;
    background: #fff;
  }

  .stats-sections {
    display: grid;
    gap: 1.5rem;
  }

  .stats-block {
    padding: 0.75rem 0;
  }

  .stats-block h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
    color: #444;
  }

  .stats-subtotal {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-top: 2px solid #ddd;
    border-bottom: 1px solid #ddd;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .stats-label {
    color: #666;
  }

  .stats-value {
    font-variant-numeric: tabular-nums;
  }

  .stats-table-wrap {
    overflow-x: auto;
  }

  .stats-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 28rem;
  }

  .stats-table th,
  .stats-table td {
    padding: 0.35rem 0.5rem;
    text-align: left;
    white-space: nowrap;
  }

  .stats-table th {
    font-weight: 600;
    color: #666;
    border-bottom: 1px solid #ddd;
  }

  .stats-table td {
    border-bottom: 1px solid #eee;
  }

  .views-cell {
    font-variant-numeric: tabular-nums;
    width: 1%;
  }
</style>
