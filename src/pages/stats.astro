---
import BaseLayout from "../layouts/BaseLayout.astro";
import { generateAbacusKey, getAbacusGetUrl } from "../lib/abacus";
import { getPosts, getSiteConfig } from "../lib/content";
import { db, PageStats, PageStatsHistory, eq } from "astro:db";

const site = await getSiteConfig();
const posts = await getPosts();
const now = Date.now();
const ONE_HOUR = 60 * 60 * 1000;

type CounterRow = {
  key: string;
  path: string;
  label: string;
  kind: "page" | "article";
  value: number | null;
};

const staticPaths = ["/", "/about/", "/submissions/", "/acknowledgements/", "/changelogs/", "/news/", "/opinion/", "/essays/", "/stats/"];

const baseRows: CounterRow[] = [
  ...staticPaths.map((path) => ({
    key: generateAbacusKey(path),
    path,
    label: path === "/" ? "Homepage" : `${path.replace(/^\//, "").replace(/\/$/, "")}`,
    kind: "page" as const,
    value: null,
  })),
  ...posts.map((post) => ({
    key: generateAbacusKey(post.url),
    path: post.url,
    label: post.title,
    kind: "article" as const,
    value: null,
  })),
];

const rowsByKey = new Map<string, CounterRow>();
for (const row of baseRows) {
  if (!rowsByKey.has(row.key)) {
    rowsByKey.set(row.key, row);
  }
}

const allRows = Array.from(rowsByKey.values());

async function fetchLiveValue(key: string): Promise<number | null> {
  try {
    const response = await fetch(getAbacusGetUrl(key));
    if (!response.ok) return null;
    const data = await response.json();
    const value = Number(data?.value);
    return Number.isFinite(value) ? value : null;
  } catch {
    return null;
  }
}

async function refreshCache() {
  for (const row of allRows) {
    const liveValue = await fetchLiveValue(row.key);
    if (liveValue === null) continue;

    await db.insert(PageStats).values({
      key: row.key,
      path: row.path,
      label: row.label,
      kind: row.kind,
      value: liveValue,
      updatedAt: now,
    }).onConflictDoUpdate({
      target: PageStats.key,
      set: { value: liveValue, updatedAt: now, path: row.path, label: row.label, kind: row.kind },
    });

    await db.insert(PageStatsHistory).values({
      key: row.key,
      value: liveValue,
      timestamp: now,
    });
  }
}

const cached = await db.select().from(PageStats);
const needsRefresh = cached.length === 0 || cached.some(r => (r.updatedAt as number) + ONE_HOUR < now);

if (needsRefresh) {
  try {
    await refreshCache();
  } catch (e) {
    console.warn("Failed to refresh cache:", e);
  }
}

const freshCache = await db.select().from(PageStats);
const history = await db.select().from(PageStatsHistory).orderBy(PageStatsHistory.timestamp);

const cacheMap = new Map(freshCache.map(r => [r.key, r]));

for (const row of allRows) {
  const cached = cacheMap.get(row.key);
  if (cached) {
    row.value = cached.value as number;
  }
}

const pages = allRows.filter(r => r.kind === "page").sort((a, b) => (b.value ?? 0) - (a.value ?? 0));
const articles = allRows.filter(r => r.kind === "article").sort((a, b) => (b.value ?? 0) - (a.value ?? 0));
const news = articles.filter(r => r.path.startsWith("/news/"));
const essays = articles.filter(r => !r.path.startsWith("/news/"));

const totalValue = freshCache.reduce((sum, r) => sum + (r.value as number), 0);

const chartData = history.reduce((acc, entry) => {
  const ts = entry.timestamp as number;
  const date = new Date(ts).toISOString().split("T")[0];
  if (!acc[date]) acc[date] = { date, total: 0 };
  acc[date].total += entry.value as number;
  return acc;
}, {} as Record<string, { date: string; total: number }>);

const chartLabels = Object.values(chartData).map(d => d.date);
const chartValues = Object.values(chartData).map(d => d.total);

const chartScript = `<script is:inline>window.chartLabels=${JSON.stringify(chartLabels)};window.chartValues=${JSON.stringify(chartValues)};</script>`;
---

<BaseLayout title="Pageview Stats" siteTitle={site.title} siteDescription={site.description}>
  <section class="stats-page">
    <h1>Pageview Stats</h1>

    <div class="stats-total-block">
      <span class="stats-total-label">All Views</span>
      <span class="stats-total-value">{totalValue.toLocaleString()}</span>
    </div>

    <div class="chart-block">
      <h2>Views Over Time</h2>
      <div class="chart-wrap">
        <canvas id="views-chart"></canvas>
      </div>
    </div>

    <div class="stats-sections">
      <section class="stats-block">
        <h2>Pages</h2>
        <div class="stats-subtotal">
          <span class="stats-label">Total</span>
          <span class="stats-value">{pages.reduce((s, r) => s + (r.value ?? 0), 0).toLocaleString()}</span>
        </div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th scope="col">Views</th>
                <th scope="col">Path</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              {pages.map((row) => (
                <tr class="stats-row">
                  <td class="views-cell">{row.value?.toLocaleString() ?? "—"}</td>
                  <td><a href={row.path}>{row.path}</a></td>
                  <td>{row.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="stats-block">
        <h2>News</h2>
        <div class="stats-subtotal">
          <span class="stats-label">Total</span>
          <span class="stats-value">{news.reduce((s, r) => s + (r.value ?? 0), 0).toLocaleString()}</span>
        </div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th scope="col">Views</th>
                <th scope="col">Path</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              {news.map((row) => (
                <tr class="stats-row">
                  <td class="views-cell">{row.value?.toLocaleString() ?? "—"}</td>
                  <td><a href={row.path}>{row.path}</a></td>
                  <td>{row.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="stats-block">
        <h2>Essays</h2>
        <div class="stats-subtotal">
          <span class="stats-label">Total</span>
          <span class="stats-value">{essays.reduce((s, r) => s + (r.value ?? 0), 0).toLocaleString()}</span>
        </div>
        <div class="stats-table-wrap">
          <table class="stats-table">
            <thead>
              <tr>
                <th scope="col">Views</th>
                <th scope="col">Path</th>
                <th scope="col">Title</th>
              </tr>
            </thead>
            <tbody>
              {essays.map((row) => (
                <tr class="stats-row">
                  <td class="views-cell">{row.value?.toLocaleString() ?? "—"}</td>
                  <td><a href={row.path}>{row.path}</a></td>
                  <td>{row.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>

  <Fragment set:html={chartScript} />

  <script>
    import Chart from "chart.js/auto";
    
    const labels = window.chartLabels || [];
    const values = window.chartValues || [];
    
    const ctx = document.getElementById("views-chart");
    if (ctx && labels.length > 0) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            data: values,
            borderColor: "#000",
            backgroundColor: "transparent",
            borderWidth: 1.5,
            pointRadius: 0,
            pointHoverRadius: 3,
            pointHoverBackgroundColor: "#000",
            tension: 0.3,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: "#fff",
              titleColor: "#000",
              bodyColor: "#000",
              borderColor: "#000",
              borderWidth: 1,
              displayColors: false,
              callbacks: {
                label: (ctx) => ctx.parsed.y.toLocaleString() + " views",
              }
            }
          },
          scales: {
            x: {
              grid: { color: "#ccc" },
              ticks: { color: "#666", font: { size: 11 } }
            },
            y: {
              grid: { color: "#ccc" },
              ticks: { color: "#666", font: { size: 11 }, callback: (v) => v.toLocaleString() }
            }
          }
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .stats-page {
    max-width: 56rem;
  }

  .stats-page h1 {
    margin-bottom: 1.5rem;
  }

  .stats-total-block {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-top: 2px solid #000;
    border-bottom: 1px solid #ddd;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .stats-total-label {
    color: #666;
  }

  .stats-total-value {
    font-size: 1.1rem;
  }

  .chart-block {
    margin-bottom: 2rem;
  }

  .chart-block h2 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: #444;
  }

  .chart-wrap {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 1rem;
    background: #fff;
  }

  .stats-sections {
    display: grid;
    gap: 1.5rem;
  }

  .stats-block {
    padding: 0.75rem 0;
  }

  .stats-block h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
    color: #444;
  }

  .stats-subtotal {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-top: 2px solid #ddd;
    border-bottom: 1px solid #ddd;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .stats-label {
    color: #666;
  }

  .stats-value {
    font-variant-numeric: tabular-nums;
  }

  .stats-table-wrap {
    overflow-x: auto;
  }

  .stats-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 28rem;
  }

  .stats-table th,
  .stats-table td {
    padding: 0.35rem 0.5rem;
    text-align: left;
    white-space: nowrap;
  }

  .stats-table th {
    font-weight: 600;
    color: #666;
    border-bottom: 1px solid #ddd;
  }

  .stats-table td {
    border-bottom: 1px solid #eee;
  }

  .views-cell {
    font-variant-numeric: tabular-nums;
    width: 1%;
  }
</style>