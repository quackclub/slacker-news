---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { generateAbacusKey, getAbacusGetUrl } from "../../lib/abacus";
import { getPosts, getSiteConfig } from "../../lib/content";
import { db, PageStats, PageStatsHistory, eq } from "astro:db";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug, post }
  }));
}

const site = await getSiteConfig();
const slug = Astro.props?.slug ?? Astro.params.slug;
const post = Astro.props?.post;
const now = Date.now();
const ONE_HOUR = 60 * 60 * 1000;

const key = generateAbacusKey(`/${slug}/`);
const url = getAbacusGetUrl(key);

async function fetchLiveValue(): Promise<number | null> {
  try {
    const response = await fetch(url);
    if (!response.ok) return null;
    const data = await response.json();
    const value = Number(data?.value);
    return Number.isFinite(value) ? value : null;
  } catch {
    return null;
  }
}

const cached = await db.select().from(PageStats).where(eq(PageStats.key, key));
const needsRefresh = cached.length === 0 || (cached[0].updatedAt as number) + ONE_HOUR < now;

let currentValue = cached.length > 0 ? cached[0].value as number : null;

if (needsRefresh) {
  const liveValue = await fetchLiveValue();
  if (liveValue !== null) {
    currentValue = liveValue;
    await db.insert(PageStats).values({
      key,
      path: `/${slug}/`,
      label: post?.title ?? slug,
      kind: "article",
      value: liveValue,
      updatedAt: now,
    }).onConflictDoUpdate({
      target: PageStats.key,
      set: { value: liveValue, updatedAt: now },
    });

    await db.insert(PageStatsHistory).values({
      key,
      value: liveValue,
      timestamp: now,
    });
  }
}

const history = await db.select().from(PageStatsHistory).where(eq(PageStatsHistory.key, key)).orderBy(PageStatsHistory.timestamp);

const chartLabels = history.map(h => new Date(h.timestamp as number).toISOString().split("T")[0]);
const chartValues = history.map(h => h.value as number);

const chartLabelsJSON = JSON.stringify(chartLabels);
const chartValuesJSON = JSON.stringify(chartValues);
---

<BaseLayout title={`Stats: ${post?.title ?? slug}`} siteTitle={site.title} siteDescription={site.description}>
  <section class="stats-page">
    <a href={`/${slug}/`} class="back-link">← Back to article</a>
    <h1>{post?.title ?? slug}</h1>

    <div class="stats-total-block">
      <span class="stats-total-label">Total Views</span>
      <span class="stats-total-value">{(currentValue ?? 0).toLocaleString()}</span>
    </div>

    {chartLabels.length > 0 && (
      <div class="chart-block">
        <h2>Views Over Time</h2>
        <div class="chart-wrap">
          <canvas id="views-chart"></canvas>
        </div>
      </div>
    )}

  <Fragment set:html={`window.chartLabels=${JSON.stringify(chartLabels)};window.chartValues=${JSON.stringify(chartValues)};`} />

  <script>
    import Chart from "chart.js/auto";
    
    const labels = window.chartLabels || [];
    const values = window.chartValues || [];
    
    const ctx = document.getElementById("views-chart");
    if (ctx && labels.length > 0) {
      new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            data: values,
            borderColor: "#000",
            backgroundColor: "transparent",
            borderWidth: 1.5,
            pointRadius: 0,
            pointHoverRadius: 3,
            pointHoverBackgroundColor: "#000",
            tension: 0.3,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: "#fff",
              titleColor: "#000",
              bodyColor: "#000",
              borderColor: "#000",
              borderWidth: 1,
              displayColors: false,
              callbacks: {
                label: (ctx) => ctx.parsed.y.toLocaleString() + " views",
              }
            }
          },
          scales: {
            x: {
              grid: { color: "#ccc" },
              ticks: { color: "#666", font: { size: 11 } }
            },
            y: {
              grid: { color: "#ccc" },
              ticks: { color: "#666", font: { size: 11 }, callback: (v) => v.toLocaleString() }
            }
          }
        }
      });
    }
  </script>
  </section>
</BaseLayout>

<style>
  .stats-page {
    max-width: 56rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: #666;
    text-decoration: none;
  }

  .back-link:hover {
    color: #000;
  }

  .stats-page h1 {
    margin-bottom: 1.5rem;
  }

  .stats-total-block {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-top: 2px solid #000;
    border-bottom: 1px solid #ddd;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .stats-total-label {
    color: #666;
  }

  .stats-total-value {
    font-size: 1.1rem;
  }

  .chart-block {
    margin-bottom: 2rem;
  }

  .chart-block h2 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: #444;
  }

  .chart-wrap {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 1rem;
    background: #fff;
  }
</style>